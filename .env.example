# Postgres connection string (Railway provides this automatically in deployed
# environments; for local dev, point at a local/dev Postgres instance).
DATABASE_URL="postgresql://user:password@localhost:5432/finance_app?schema=public"

# Auth.js
AUTH_SECRET="generate-with: openssl rand -base64 33"
AUTH_URL="http://localhost:3000"
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Gemini API (free tier) — used for AI-assisted transaction categorization
GEMINI_API_KEY=""

# Plaid (Phase 2)
PLAID_CLIENT_ID=""
PLAID_SECRET=""
PLAID_ENV="sandbox"

# AES-256-GCM key (32 bytes / 64 hex chars) used to encrypt Plaid access
# tokens at rest — see packages/plaid-sync/src/crypto.ts. Generate with:
# openssl rand -hex 32
ENCRYPTION_KEY=""

# IBKR Flex Query (Phase 3) — per-account flex tokens/query IDs are stored in
# the database (ibkr_flex_configs), not here.
