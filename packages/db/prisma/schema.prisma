generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  schemas  = ["auth", "app"]
}

// =========================================================================
// Auth.js (NextAuth) — model names must stay User/Account/Session/
// VerificationToken for @auth/prisma-adapter to work without a custom
// adapter. Domain "financial account" is modeled separately as
// FinancialAccount to avoid colliding with Auth's Account model.
// =========================================================================

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime? @map("email_verified")
  image         String?

  accounts Account[]
  sessions Session[]
  profile  AppUser?

  @@map("users")
  @@schema("auth")
}

model Account {
  id                String  @id @default(cuid())
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
  @@schema("auth")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
  @@schema("auth")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
  @@schema("auth")
}

// =========================================================================
// App domain — profile
// =========================================================================

model AppUser {
  id              String   @id
  defaultCurrency String   @default("USD") @map("default_currency")
  locale          String   @default("en-US")
  timezone        String   @default("UTC")
  createdAt       DateTime @default(now()) @map("created_at")

  authUser User @relation(fields: [id], references: [id], onDelete: Cascade)

  financialAccounts     FinancialAccount[]
  categories            Category[]
  budgets               Budget[]
  budgetPeriodSnapshots BudgetPeriodSnapshot[]
  sinkingFunds          SinkingFund[]
  prepaidCoverages      PrepaidCoverage[]
  categorizationRules   CategorizationRule[]
  recurringSeries       RecurringSeries[]
  targetAllocations     TargetAllocation[]
  holdingBuckets        HoldingBucketAssignment[]
  instrumentTypeOverrides InstrumentTypeOverride[]
  alertRules            AlertRule[]
  alertEvents           AlertEvent[]
  importBatches         ImportBatch[]
  csvImportTemplates    CsvImportTemplate[]
  plaidItems            PlaidItem[]
  finverseConnections   FinverseConnection[]
  transactions          Transaction[]
  accountBalanceSnapshots AccountBalanceSnapshot[]
  transferMatchCandidates TransferMatchCandidate[]
  reversalMatchCandidates ReversalMatchCandidate[]
  obligations             Obligation[]
  incomeStreams           IncomeStream[]
  cashReserves            CashReserve[]

  @@map("users")
  @@schema("app")
}

// =========================================================================
// Reference data
// =========================================================================

model Currency {
  code          String @id
  symbol        String
  decimalPlaces Int    @default(2) @map("decimal_places")
  name          String

  @@map("currencies")
  @@schema("app")
}

model ExchangeRate {
  id            String   @id @default(cuid())
  baseCurrency  String   @map("base_currency")
  quoteCurrency String   @map("quote_currency")
  rate          Decimal  @db.Decimal(18, 8)
  asOfDate      DateTime @map("as_of_date") @db.Date
  source        String

  @@unique([baseCurrency, quoteCurrency, asOfDate])
  @@map("exchange_rates")
  @@schema("app")
}

// =========================================================================
// Accounts & sync
// =========================================================================

enum AccountType {
  checking
  savings
  credit_card
  brokerage
  cash
  loan
  other

  @@schema("app")
}

enum AccountClassification {
  asset
  liability

  @@schema("app")
}

enum SyncSource {
  plaid
  ibkr_flex
  finverse
  csv
  manual

  @@schema("app")
}

model FinancialAccount {
  id                 String                 @id @default(cuid())
  userId             String                 @map("user_id")
  name               String
  type               AccountType
  classification     AccountClassification
  currency           String
  institutionName    String?                @map("institution_name")
  syncSource         SyncSource             @map("sync_source")
  externalAccountId  String?                @map("external_account_id")
  isArchived         Boolean                @default(false) @map("is_archived")
  // Plaid-reported real balance (from /accounts/balance/get, a real-time,
  // non-cached call), refreshed on every sync. Null for non-Plaid accounts
  // -- those keep using the transaction-sum balance, there's no external
  // source of truth to prefer for them.
  currentBalance     Decimal?               @map("current_balance") @db.Decimal(18, 4)
  balanceAsOf        DateTime?              @map("balance_as_of")
  balanceIsCanonical Boolean @default(false) @map("balance_is_canonical")

  user AppUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  transactions          Transaction[]
  ibkrFlexConfig        IbkrFlexConfig?
  investmentHoldings    InvestmentHolding[]
  investmentHoldingsHistory InvestmentHoldingHistory[]
  investmentTransactions InvestmentTransaction[]
  importBatches         ImportBatch[]
  alertRules            AlertRule[]
  balanceSnapshots      AccountBalanceSnapshot[]
  obligations           Obligation[]
  incomeStreams         IncomeStream[]
  cashReserves          CashReserve[]

  @@index([userId])
  @@map("accounts")
  @@schema("app")
}

// =========================================================================
// Balance history
// =========================================================================

enum BalanceCalculationMethod {
  transaction_sum
  institution_reported
  holdings_derived

  @@schema("app")
}

// One row per account per day, upserted so re-running the same day updates
// in place rather than duplicating. `method` records how `balance` was
// derived that day (see computeAccountBalance in @finance-app/finance-logic)
// so a downstream consumer (e.g. an AI export) knows whether a given day's
// number is institution-reported, holdings-derived, or a transaction-sum
// fallback -- the same three-tier precedence already used live on the
// Accounts and Dashboard pages, just persisted daily instead of recomputed
// only for "today."
model AccountBalanceSnapshot {
  id        String                    @id @default(cuid())
  accountId String                    @map("account_id")
  userId    String                    @map("user_id")
  asOfDate  DateTime                  @map("as_of_date") @db.Date
  balance   Decimal                   @db.Decimal(18, 4)
  currency  String
  method    BalanceCalculationMethod
  sourceAsOf DateTime? @map("source_as_of")
  recordedAt DateTime @default(now()) @map("recorded_at")
  isComplete Boolean @default(false) @map("is_complete")
  valuationVersion Int @default(1) @map("valuation_version")

  account FinancialAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  user    AppUser          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([accountId, asOfDate])
  @@index([userId, asOfDate])
  @@map("account_balance_snapshots")
  @@schema("app")
}

model PlaidItem {
  id              String    @id @default(cuid())
  userId          String    @map("user_id")
  plaidItemId     String    @unique @map("plaid_item_id")
  accessToken     String    @map("access_token")
  institutionName String?   @map("institution_name")
  status          String    @default("active")
  cursor          String?
  lastSyncedAt    DateTime? @map("last_synced_at")

  user AppUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("plaid_items")
  @@schema("app")
}

model FinverseConnection {
  id              String    @id @default(cuid())
  userId          String    @map("user_id")
  loginIdentityId String    @unique @map("login_identity_id")
  accessToken     String    @map("access_token")
  institutionName String?   @map("institution_name")
  status          String    @default("active")
  lastSyncedAt    DateTime? @map("last_synced_at")

  user AppUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("finverse_connections")
  @@schema("app")
}

model IbkrFlexConfig {
  id             String    @id @default(cuid())
  userId         String    @map("user_id")
  accountId      String    @unique @map("account_id")
  flexToken      String    @map("flex_token")
  flexQueryId    String    @map("flex_query_id")
  lastRunAt      DateTime? @map("last_run_at")
  lastReportDate DateTime? @map("last_report_date") @db.Date
  status         String    @default("active")

  account FinancialAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@map("ibkr_flex_configs")
  @@schema("app")
}

// =========================================================================
// Ledger
// =========================================================================

enum CategorySource {
  rule
  ai
  manual
  uncategorized

  @@schema("app")
}

model Transaction {
  id                    String         @id @default(cuid())
  userId                String         @map("user_id")
  accountId             String         @map("account_id")
  amount                Decimal        @db.Decimal(18, 4)
  currency              String
  description           String
  merchantName          String?        @map("merchant_name")
  date                  DateTime       @db.Date
  authorizedDate        DateTime?      @map("authorized_date") @db.Date
  categoryId            String?        @map("category_id")
  categoryConfidence    Decimal?       @map("category_confidence") @db.Decimal(4, 3)
  categorizationAttemptedAt DateTime? @map("categorization_attempted_at")
  categorySource        CategorySource @default(uncategorized) @map("category_source")
  isTransfer            Boolean        @default(false) @map("is_transfer")
  transferPairId        String?        @unique @map("transfer_pair_id")
  pending               Boolean        @default(false)
  externalTransactionId String?        @map("external_transaction_id")
  importBatchId         String?        @map("import_batch_id")
  notes                 String?

  user         AppUser           @relation(fields: [userId], references: [id], onDelete: Cascade)
  account      FinancialAccount  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  category     Category?         @relation(fields: [categoryId], references: [id])
  importBatch  ImportBatch?      @relation(fields: [importBatchId], references: [id])
  transferPair Transaction?      @relation("TransferPair", fields: [transferPairId], references: [id])
  transferOf   Transaction?      @relation("TransferPair")

  // Set when this transaction was reconciled against an IBKR deposit/withdrawal
  // (InvestmentTransaction) rather than another bank Transaction -- see
  // TransferMatchCandidate. InvestmentTransaction has no relation back to
  // Transaction otherwise, since IBKR accounts have zero Transaction rows.
  linkedInvestmentTransactionId String?                @unique @map("linked_investment_transaction_id")
  linkedInvestmentTransaction   InvestmentTransaction? @relation(fields: [linkedInvestmentTransactionId], references: [id])

  splits                  TransactionSplit[]
  sinkingFundContribs     SinkingFundContribution[]
  recurringSeriesLinks    RecurringSeriesTransaction[]
  transferMatchCandidates TransferMatchCandidate[]
  reversalCandidatesAsCharge    ReversalMatchCandidate[] @relation("ReversalChargeSide")
  reversalCandidatesAsReversal  ReversalMatchCandidate[] @relation("ReversalReversalSide")

  @@unique([accountId, externalTransactionId])
  @@index([userId, date(sort: Desc)])
  @@index([accountId, date(sort: Desc)])
  @@map("transactions")
  @@schema("app")
}

enum SplitType {
  gross_addition
  deduction

  @@schema("app")
}

model TransactionSplit {
  id            String    @id @default(cuid())
  transactionId String    @map("transaction_id")
  label         String
  amount        Decimal   @db.Decimal(18, 4)
  splitType     SplitType @map("split_type")
  categoryId    String?   @map("category_id")

  transaction Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  category    Category?   @relation(fields: [categoryId], references: [id])

  @@index([transactionId])
  @@map("transaction_splits")
  @@schema("app")
}

enum TransferCounterpartType {
  transaction
  investment_transaction

  @@schema("app")
}

enum TransferMatchStatus {
  pending
  confirmed
  dismissed

  @@schema("app")
}

// A candidate pairing proposed by the nightly transfer-matching job for a
// synced transaction that looks like an internal transfer (Plaid/IBKR/
// Finverse/CSV transactions are never auto-flagged as transfers the way a
// manually-entered one can be). `transactionId` is always a real bank
// Transaction (the "anchor" -- for a Transaction<->Transaction pair, the
// outflow side is always the anchor, a fixed rule so the same real pair is
// never proposed twice). The counterpart is polymorphic (mirrors the
// AlertEvent.relatedEntityType/relatedEntityId pattern already used
// elsewhere in this schema) since it can be either another Transaction or
// an InvestmentTransaction (IBKR deposit/withdrawal), which has no typed
// relation to Transaction at all.
model TransferMatchCandidate {
  id              String                  @id @default(cuid())
  userId          String                  @map("user_id")
  transactionId   String                  @map("transaction_id")
  counterpartType TransferCounterpartType @map("counterpart_type")
  counterpartId   String                  @map("counterpart_id")
  confidenceScore Decimal                 @map("confidence_score") @db.Decimal(4, 3)
  status          TransferMatchStatus     @default(pending)
  detectedAt      DateTime                @default(now()) @map("detected_at")
  resolvedAt      DateTime?               @map("resolved_at")

  user        AppUser     @relation(fields: [userId], references: [id], onDelete: Cascade)
  transaction Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  @@unique([transactionId, counterpartType, counterpartId])
  @@index([userId, status])
  @@map("transfer_match_candidates")
  @@schema("app")
}

enum ReversalMatchStatus {
  pending
  confirmed
  dismissed

  @@schema("app")
}

// A candidate pairing proposed by the nightly reversal-matching job (see
// matchReversals in @finance-app/finance-logic) for two same-account
// transactions that look like a charge and its later reversal/refund --
// e.g. a $432.28 charge followed by a $432.28 credit from the same
// merchant. Unlike TransferMatchCandidate, both sides are always a real
// bank Transaction (matchReversals' hard gates require same account/
// currency, so there is no polymorphic counterpart to model here) --
// `chargeTransactionId` is always the negative (money-out) side and
// `reversalTransactionId` the positive (money-in) side, assigned from the
// real amount signs at detection time, not from matchReversals' own
// unordered {aId,bId} output (which carries no directional information).
// Confirming a candidate never edits either Transaction row -- this is a
// presentation/relationship layer over the existing ledger, not a rewrite
// of it.
model ReversalMatchCandidate {
  id                     String              @id @default(cuid())
  userId                 String              @map("user_id")
  chargeTransactionId    String              @map("charge_transaction_id")
  reversalTransactionId  String              @map("reversal_transaction_id")
  confidenceScore        Decimal             @map("confidence_score") @db.Decimal(4, 3)
  daysApart              Int                 @map("days_apart")
  status                 ReversalMatchStatus @default(pending)
  detectedAt             DateTime            @default(now()) @map("detected_at")
  resolvedAt             DateTime?           @map("resolved_at")

  user                AppUser     @relation(fields: [userId], references: [id], onDelete: Cascade)
  chargeTransaction   Transaction @relation("ReversalChargeSide", fields: [chargeTransactionId], references: [id], onDelete: Cascade)
  reversalTransaction Transaction @relation("ReversalReversalSide", fields: [reversalTransactionId], references: [id], onDelete: Cascade)

  @@unique([chargeTransactionId, reversalTransactionId])
  @@index([userId, status])
  @@map("reversal_match_candidates")
  @@schema("app")
}

// =========================================================================
// Categories & budgets
// =========================================================================

enum CategoryKind {
  income
  expense
  transfer

  @@schema("app")
}

enum BudgetType {
  none
  monthly_reset
  rollover_envelope
  sinking_fund
  prepaid_coverage

  @@schema("app")
}

model Category {
  id               String     @id @default(cuid())
  userId           String     @map("user_id")
  name             String
  parentCategoryId String?    @map("parent_category_id")
  kind             CategoryKind
  budgetType       BudgetType @default(none) @map("budget_type")
  icon             String?
  color            String?
  sortOrder        Int        @default(0) @map("sort_order")
  isArchived       Boolean    @default(false) @map("is_archived")
  pinnedToDashboard Boolean   @default(false) @map("pinned_to_dashboard")

  user           AppUser    @relation(fields: [userId], references: [id], onDelete: Cascade)
  parentCategory Category?  @relation("CategoryHierarchy", fields: [parentCategoryId], references: [id])
  children       Category[] @relation("CategoryHierarchy")

  transactions       Transaction[]
  transactionSplits  TransactionSplit[]
  budgets            Budget[]
  budgetSnapshots    BudgetPeriodSnapshot[]
  sinkingFunds       SinkingFund[]
  prepaidCoverage    PrepaidCoverage?
  categorizationRules CategorizationRule[]
  recurringSeries    RecurringSeries[]
  obligations        Obligation[]

  @@index([userId])
  @@map("categories")
  @@schema("app")
}

enum BudgetPeriod {
  weekly
  monthly
  quarterly
  annual

  @@schema("app")
}

model Budget {
  id              String       @id @default(cuid())
  userId          String       @map("user_id")
  categoryId      String       @map("category_id")
  amount          Decimal      @db.Decimal(18, 4)
  currency        String
  period          BudgetPeriod
  rolloverEnabled Boolean      @default(false) @map("rollover_enabled")
  rolloverCap     Decimal?     @map("rollover_cap") @db.Decimal(18, 4)
  effectiveFrom   DateTime     @map("effective_from") @db.Date
  effectiveTo     DateTime?    @map("effective_to") @db.Date

  user     AppUser  @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@index([categoryId, effectiveFrom])
  @@map("budgets")
  @@schema("app")
}

model BudgetPeriodSnapshot {
  id               String   @id @default(cuid())
  userId           String   @map("user_id")
  categoryId       String   @map("category_id")
  periodStart      DateTime @map("period_start") @db.Date
  periodEnd        DateTime @map("period_end") @db.Date
  allottedAmount   Decimal  @map("allotted_amount") @db.Decimal(18, 4)
  rolledOverAmount Decimal  @default(0) @map("rolled_over_amount") @db.Decimal(18, 4)
  spentAmount      Decimal  @map("spent_amount") @db.Decimal(18, 4)
  remainingAmount  Decimal  @map("remaining_amount") @db.Decimal(18, 4)
  computedAt       DateTime @default(now()) @map("computed_at")

  user     AppUser  @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([categoryId, periodStart])
  @@map("budget_period_snapshots")
  @@schema("app")
}

enum SinkingFundRecurrence {
  one_time
  repeating

  @@schema("app")
}

model SinkingFund {
  id                 String                @id @default(cuid())
  userId             String                @map("user_id")
  categoryId         String?               @map("category_id")
  name               String
  targetAmount       Decimal               @map("target_amount") @db.Decimal(18, 4)
  currency           String
  deadlineDate       DateTime              @map("deadline_date") @db.Date
  recurrence         SinkingFundRecurrence @default(one_time)
  recurrenceInterval String?               @map("recurrence_interval")
  currentBalance     Decimal               @default(0) @map("current_balance") @db.Decimal(18, 4)

  user     AppUser   @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category? @relation(fields: [categoryId], references: [id])

  contributions SinkingFundContribution[]

  @@index([userId])
  @@map("sinking_funds")
  @@schema("app")
}

model SinkingFundContribution {
  id            String   @id @default(cuid())
  sinkingFundId String   @map("sinking_fund_id")
  transactionId String?  @map("transaction_id")
  amount        Decimal  @db.Decimal(18, 4)
  date          DateTime @db.Date
  note          String?

  sinkingFund SinkingFund  @relation(fields: [sinkingFundId], references: [id], onDelete: Cascade)
  transaction Transaction? @relation(fields: [transactionId], references: [id])

  @@index([sinkingFundId])
  @@map("sinking_fund_contributions")
  @@schema("app")
}

// budget_type = prepaid_coverage: no dollar cap and no version history --
// unlike Budget, this is a single in-place-edited policy ("paid every N
// months"), not a versioned amount. The paid-through date and last payment
// amount are computed live from Transaction on every read (see
// computePrepaidCoverageProgress in apps/web), not cached here.
model PrepaidCoverage {
  id             String @id @default(cuid())
  userId         String @map("user_id")
  categoryId     String @unique @map("category_id")
  coverageMonths Int    @map("coverage_months")

  user     AppUser  @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@map("prepaid_coverages")
  @@schema("app")
}

// =========================================================================
// Categorization intelligence
// =========================================================================

enum RuleMatchType {
  exact_merchant
  contains
  regex

  @@schema("app")
}

enum RuleSource {
  user_created
  learned_from_correction

  @@schema("app")
}

model CategorizationRule {
  id            String        @id @default(cuid())
  userId        String        @map("user_id")
  matchType     RuleMatchType @map("match_type")
  pattern       String
  categoryId    String        @map("category_id")
  priority      Int           @default(0)
  source        RuleSource    @default(user_created)
  matchCount    Int           @default(0) @map("match_count")
  isActive      Boolean       @default(true) @map("is_active")
  lastMatchedAt DateTime?     @map("last_matched_at")

  user     AppUser  @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@index([userId, priority])
  @@map("categorization_rules")
  @@schema("app")
}

enum RecurringCadence {
  weekly
  biweekly
  monthly
  quarterly
  annual
  irregular

  @@schema("app")
}

enum RecurringStatus {
  active
  amount_changed
  missed
  cancelled
  merged

  @@schema("app")
}

model RecurringSeries {
  id                 String           @id @default(cuid())
  userId             String           @map("user_id")
  merchantKey        String           @map("merchant_key")
  groupKey           String?          @map("group_key")
  categoryId         String?          @map("category_id")
  cadence            RecurringCadence
  expectedAmount     Decimal          @map("expected_amount") @db.Decimal(18, 4)
  amountTolerancePct Decimal          @default(0.10) @map("amount_tolerance_pct") @db.Decimal(4, 3)
  currency           String
  lastSeenDate       DateTime         @map("last_seen_date") @db.Date
  nextExpectedDate   DateTime?        @map("next_expected_date") @db.Date
  status             RecurringStatus  @default(active)
  confidenceScore    Decimal          @map("confidence_score") @db.Decimal(4, 3)

  user     AppUser   @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category? @relation(fields: [categoryId], references: [id])

  transactions RecurringSeriesTransaction[]
  events       RecurringSeriesEvent[]

  @@unique([userId, groupKey])
  @@map("recurring_series")
  @@schema("app")
}

model RecurringSeriesTransaction {
  recurringSeriesId String @map("recurring_series_id")
  transactionId      String @unique @map("transaction_id")

  recurringSeries RecurringSeries @relation(fields: [recurringSeriesId], references: [id], onDelete: Cascade)
  transaction     Transaction     @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  @@id([recurringSeriesId, transactionId])
  @@map("recurring_series_transactions")
  @@schema("app")
}

enum RecurringEventType {
  amount_increased
  amount_decreased
  missed
  resumed
  cancelled

  @@schema("app")
}

model RecurringSeriesEvent {
  id                 String             @id @default(cuid())
  recurringSeriesId  String             @map("recurring_series_id")
  eventType          RecurringEventType @map("event_type")
  oldValue           String?            @map("old_value")
  newValue           String?            @map("new_value")
  detectedAt         DateTime           @default(now()) @map("detected_at")
  acknowledged       Boolean            @default(false)

  recurringSeries RecurringSeries @relation(fields: [recurringSeriesId], references: [id], onDelete: Cascade)

  @@index([recurringSeriesId])
  @@map("recurring_series_events")
  @@schema("app")
}

// =========================================================================
// Investments
// =========================================================================

model InvestmentHolding {
  id             String   @id @default(cuid())
  accountId      String   @map("account_id")
  symbol         String
  // Raw IBKR Flex OpenPosition.assetCategory (e.g. "STK", "BOND", "CASH") --
  // a broker fact, not Meadow's normalized instrument-type interpretation.
  // See classifyInstrumentType in @finance-app/finance-logic, which combines
  // this with ibkrSubCategory (below) and any InstrumentTypeOverride.
  securityType   String   @map("security_type")
  // Raw IBKR Flex OpenPosition.subCategory (e.g. "COMMON", "ETF",
  // "CLOSED-END FUND"). Null for asset categories where IBKR doesn't report
  // one (CASH, and any position synced before this field existed). This is
  // the field that actually distinguishes an ETF from an individual stock --
  // securityType alone reports both as "STK".
  ibkrSubCategory String? @map("ibkr_sub_category")
  quantity       Decimal  @db.Decimal(20, 8)
  avgCost        Decimal? @map("avg_cost") @db.Decimal(18, 4)
  currency       String
  marketValue    Decimal  @map("market_value") @db.Decimal(18, 4)
  asOfDate       DateTime @map("as_of_date") @db.Date
  assetClassTag  String?  @map("asset_class_tag")

  account FinancialAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([accountId, symbol, asOfDate])
  @@map("investment_holdings")
  @@schema("app")
}

enum InstrumentType {
  stock
  etf
  fund
  bond
  cash
  crypto
  option
  other
  unknown

  @@schema("app")
}

// Manual correction of a symbol's normalized instrument type, independent of
// HoldingBucketAssignment (that's strategy, this is "what the security IS").
// Persists across IBKR re-syncs since it's keyed by symbol, not by any
// per-snapshot InvestmentHolding row -- see classifyInstrumentType's
// priority order (this always wins over IBKR metadata/deterministic rules).
model InstrumentTypeOverride {
  userId         String         @map("user_id")
  symbol         String
  instrumentType InstrumentType @map("instrument_type")

  user AppUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, symbol])
  @@map("instrument_type_overrides")
  @@schema("app")
}

model InvestmentHoldingHistory {
  id          String   @id @default(cuid())
  accountId   String   @map("account_id")
  symbol      String
  quantity    Decimal  @db.Decimal(20, 8)
  marketValue Decimal  @map("market_value") @db.Decimal(18, 4)
  asOfDate    DateTime @map("as_of_date") @db.Date

  account FinancialAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([accountId, symbol, asOfDate])
  @@map("investment_holdings_history")
  @@schema("app")
}

enum InvestmentTradeType {
  buy
  sell
  dividend
  interest
  fee
  deposit
  withdrawal

  @@schema("app")
}

model InvestmentTransaction {
  id         String              @id @default(cuid())
  accountId  String              @map("account_id")
  symbol     String?
  tradeType  InvestmentTradeType @map("trade_type")
  quantity   Decimal?            @db.Decimal(20, 8)
  price      Decimal?            @db.Decimal(18, 4)
  amount     Decimal             @db.Decimal(18, 4)
  currency   String
  tradeDate  DateTime            @map("trade_date") @db.Date
  externalId String?             @map("external_id")

  account FinancialAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  // Reverse side of Transaction.linkedInvestmentTransactionId -- set when a
  // bank Transaction (e.g. a brokerage-funding withdrawal) has been
  // reconciled against this deposit/withdrawal row via TransferMatchCandidate.
  linkedFromTransaction Transaction?

  @@unique([accountId, externalId])
  @@map("investment_transactions")
  @@schema("app")
}

model TargetAllocation {
  id                String  @id @default(cuid())
  userId            String  @map("user_id")
  bucketName        String  @map("bucket_name")
  targetWeightPct   Decimal @map("target_weight_pct") @db.Decimal(5, 2)
  driftThresholdPct Decimal @map("drift_threshold_pct") @db.Decimal(5, 2)

  user AppUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, bucketName])
  @@map("target_allocations")
  @@schema("app")
}

enum BucketAssignmentSource {
  user
  default_rule

  @@schema("app")
}

model HoldingBucketAssignment {
  userId     String                 @map("user_id")
  symbol     String
  bucketName String                 @map("bucket_name")
  assignedBy BucketAssignmentSource @default(user) @map("assigned_by")

  user AppUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, symbol])
  @@map("holding_bucket_assignments")
  @@schema("app")
}

// =========================================================================
// Alerts
// =========================================================================

enum AlertRuleType {
  budget_over_target
  emergency_fund_below_floor
  portfolio_drift
  sinking_fund_underfunded
  recurring_amount_changed
  recurring_missed
  large_transaction
  low_balance

  @@schema("app")
}

model AlertRule {
  id            String        @id @default(cuid())
  userId        String        @map("user_id")
  ruleType      AlertRuleType @map("rule_type")
  config        Json
  categoryId    String?       @map("category_id")
  accountId     String?       @map("account_id")
  sinkingFundId String?       @map("sinking_fund_id")
  isActive      Boolean       @default(true) @map("is_active")

  user    AppUser           @relation(fields: [userId], references: [id], onDelete: Cascade)
  account FinancialAccount? @relation(fields: [accountId], references: [id])

  events AlertEvent[]

  @@index([userId])
  @@map("alert_rules")
  @@schema("app")
}

model AlertEvent {
  id                String    @id @default(cuid())
  alertRuleId       String?   @map("alert_rule_id")
  userId            String    @map("user_id")
  severity          String
  title             String
  message           String
  relatedEntityType String?   @map("related_entity_type")
  relatedEntityId   String?   @map("related_entity_id")
  triggeredAt       DateTime  @default(now()) @map("triggered_at")
  acknowledgedAt    DateTime? @map("acknowledged_at")
  resolvedAt        DateTime? @map("resolved_at")

  alertRule AlertRule? @relation(fields: [alertRuleId], references: [id])
  user      AppUser    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, triggeredAt(sort: Desc)])
  @@map("alert_events")
  @@schema("app")
}

// =========================================================================
// Planning — future obligations, expected income, reserved cash
// =========================================================================

// Deliberately separate from RecurringCadence (used by RecurringSeries,
// which is an auto-detected backward-looking pattern from transaction
// history, not a user-declared future commitment): this needs one_time and
// semiannual, and has no use for RecurringCadence's irregular value. Shared
// between Obligation and IncomeStream rather than duplicated.
enum ObligationFrequency {
  one_time
  weekly
  biweekly
  monthly
  quarterly
  semiannual
  annual

  @@schema("app")
}

enum ObligationPriority {
  mandatory
  planned
  discretionary

  @@schema("app")
}

// A user-declared future bill/commitment (car insurance, housing, a planned
// large purchase). fundedAmount is manually tracked the same way
// SinkingFund.currentBalance already is -- not derived from transactions,
// since matching a real payment to an obligation reliably isn't something
// this app's categorization can do. Funding status
// (unfunded/partially_funded/fully_funded) is computed live from amount vs.
// fundedAmount (see classifyFundingStatus in @finance-app/finance-logic),
// not stored, matching PrepaidCoverage's existing convention of computing
// status on read rather than caching it.
model Obligation {
  id           String              @id @default(cuid())
  userId       String              @map("user_id")
  name         String
  amount       Decimal             @db.Decimal(18, 4)
  currency     String
  frequency    ObligationFrequency
  nextDueDate  DateTime            @map("next_due_date") @db.Date
  priority     ObligationPriority  @default(planned)
  fundedAmount Decimal             @default(0) @map("funded_amount") @db.Decimal(18, 4)
  accountId    String?             @map("account_id")
  categoryId   String?             @map("category_id")
  isActive     Boolean             @default(true) @map("is_active")

  user     AppUser           @relation(fields: [userId], references: [id], onDelete: Cascade)
  account  FinancialAccount? @relation(fields: [accountId], references: [id])
  category Category?         @relation(fields: [categoryId], references: [id])

  @@index([userId])
  @@map("obligations")
  @@schema("app")
}

enum IncomeConfidence {
  confirmed
  estimated

  @@schema("app")
}

// A user-declared forward-looking income schedule (salary, an allowance, a
// fixed-term job) -- distinct from the actual received Transaction rows,
// which this app has no itemized payroll (gross/deductions/net) breakdown
// for yet (see the dead TransactionSplit model).
model IncomeStream {
  id               String              @id @default(cuid())
  userId           String              @map("user_id")
  name             String
  currency         String
  frequency        ObligationFrequency
  grossAmount      Decimal             @map("gross_amount") @db.Decimal(18, 4)
  netAmount        Decimal?            @map("net_amount") @db.Decimal(18, 4)
  nextExpectedDate DateTime            @map("next_expected_date") @db.Date
  endDate          DateTime?           @map("end_date") @db.Date
  confidence       IncomeConfidence    @default(estimated)
  accountId        String?             @map("account_id")
  isActive         Boolean             @default(true) @map("is_active")

  user    AppUser           @relation(fields: [userId], references: [id], onDelete: Cascade)
  account FinancialAccount? @relation(fields: [accountId], references: [id])

  @@index([userId])
  @@map("income_streams")
  @@schema("app")
}

// An ongoing cash floor ("this money in my account isn't actually free to
// spend"), deliberately NOT built on SinkingFund -- a reserve is an ongoing
// floor with no deadline, a sinking fund is a save-toward-a-deadline target.
// accountId null means the reserve applies to a whole currency rather than
// one specific account.
model CashReserve {
  id            String   @id @default(cuid())
  userId        String   @map("user_id")
  name          String
  currency      String
  targetAmount  Decimal  @map("target_amount") @db.Decimal(18, 4)
  minimumAmount Decimal? @map("minimum_amount") @db.Decimal(18, 4)
  accountId     String?  @map("account_id")

  user    AppUser           @relation(fields: [userId], references: [id], onDelete: Cascade)
  account FinancialAccount? @relation(fields: [accountId], references: [id])

  @@index([userId])
  @@map("cash_reserves")
  @@schema("app")
}

// =========================================================================
// Import & onboarding
// =========================================================================

model ImportBatch {
  id               String   @id @default(cuid())
  userId           String   @map("user_id")
  accountId        String   @map("account_id")
  sourceFilename   String   @map("source_filename")
  rowCount         Int      @map("row_count")
  importedCount    Int      @default(0) @map("imported_count")
  duplicateCount   Int      @default(0) @map("duplicate_count")
  errorCount       Int      @default(0) @map("error_count")
  status           String   @default("pending")
  columnMapping    Json?    @map("column_mapping")
  createdAt        DateTime @default(now()) @map("created_at")

  user        AppUser          @relation(fields: [userId], references: [id], onDelete: Cascade)
  account     FinancialAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@map("import_batches")
  @@schema("app")
}

model CsvImportTemplate {
  id                    String  @id @default(cuid())
  userId                String  @map("user_id")
  institutionName       String  @map("institution_name")
  columnMapping         Json    @map("column_mapping")
  dateFormat            String  @map("date_format")
  amountSignConvention  String  @map("amount_sign_convention")

  user AppUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, institutionName])
  @@map("csv_import_templates")
  @@schema("app")
}

model CategoryTemplate {
  id          String @id @default(cuid())
  name        String @unique
  description String?

  items CategoryTemplateItem[]

  @@map("category_templates")
  @@schema("app")
}

model CategoryTemplateItem {
  id                 String       @id @default(cuid())
  categoryTemplateId String       @map("category_template_id")
  name               String
  parentName         String?      @map("parent_name")
  kind               CategoryKind
  budgetType         BudgetType   @default(none) @map("budget_type")
  icon               String?
  color              String?
  sortOrder          Int          @default(0) @map("sort_order")

  categoryTemplate CategoryTemplate @relation(fields: [categoryTemplateId], references: [id], onDelete: Cascade)

  @@map("category_template_items")
  @@schema("app")
}

// OAuth attempts are single use and tied to the initiating browser and user.
model OAuthLinkAttempt {
  stateHash String @id @map("state_hash")
  userId String @map("user_id")
  expiresAt DateTime @map("expires_at")
  @@index([expiresAt])
  @@map("oauth_link_attempts")
  @@schema("app")
}

model JobRun {
  id String @id @default(cuid())
  name String
  startedAt DateTime @default(now()) @map("started_at")
  finishedAt DateTime? @map("finished_at")
  status String
  @@index([name, startedAt])
  @@map("job_runs")
  @@schema("app")
}
